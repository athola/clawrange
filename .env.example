# AI MSP Testbed — Environment Configuration Template
# Copy this to .env and fill in real values:  cp .env.example .env

# OpenRouter API key — get from https://openrouter.ai/settings/keys
# Keep balance above $10 for testing. All LLM calls route through this.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Total credits deposited on OpenRouter (used to calculate remaining balance).
# The proxy blocks paid-tier fallback when balance drops near $10 to protect
# the 1000 req/day free quota. Update this when you add credits.

# OpenClaw gateway auth token — change this to something unique per deployment
OPENCLAW_GATEWAY_TOKEN=testbed-token-change-me

# Service ports (defaults match the testbed guide)
OPENCLAW_PORT=3000
WORKFLOWS_PORT=5678
DEERFLOW_PORT=2026

# Tailscale IP of this node — required for production mode (make start-prod)
# Find yours with: tailscale ip -4
TAILSCALE_IP=

# Z.AI API key — for GLM 5.2 direct access (Tier 2 fallback)
# Get from Z.AI dashboard
ZAI_API_KEY=your-zai-key-here

# Embeddings backend for the /v1/embeddings proxy route (OpenClaw memory).
# Defaults below reuse ZAI_API_KEY against Zhipu's embedding-3. NOTE: a GLM
# Coding Plan key cannot serve embeddings (returns model-not-found); set
# ZAI_EMBED_API_KEY to a regular pay-as-you-go BigModel key that has the
# embeddings API enabled. Leave blank to fall back to ZAI_API_KEY.
ZAI_EMBED_API_KEY=
# ZAI_EMBED_MODEL=embedding-3
# ZAI_EMBED_URL=https://open.bigmodel.cn/api/paas/v4/embeddings

# Internal auth token for LLM proxy endpoint
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_AUTH_TOKEN=generate-a-token-here

# Telegram bot notifications — for rate limit and fallback alerts
# Create bot via @BotFather, get chat ID from /getUpdates
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Timezone for all services (activeHours, cron schedules, logs)
TIMEZONE=America/Chicago

# ─── Marketing Orchestrator ───────────────────────────────────────

# Reddit API — script app via https://www.reddit.com/prefs/apps
# Create a "script" type app (for personal use, not OAuth flow)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=clawrange-marketing-bot/0.1

# GitHub PAT — for search API and repo traffic stats
# Needs repo scope for traffic endpoints, public_repo for search
GITHUB_PAT=

# Scheduler timezone (defaults to America/Chicago)
SCHEDULER_TZ=America/Chicago

# ─── Multi-Tenant Profile ─────────────────────────────────────────

# Which tenant profile to load from config/profiles/<name>/profile.yaml.
# Defaults to "starter" — the identity-free baseline shipped for fresh
# clones. Ships with "lead-crm" (a business reference) and "marketing"
# (a John-117 content-marketing example). Copy one, rename it, edit the
# fields, and point this at the new name to build your own assistant.
# Add an `identity` block to the profile (name/creature/vibe/emoji) and run
# `make persona PROFILE=<name>` to render soul.md + identity.md.
CLAWRANGE_PROFILE=starter

# ─── Persona meta-learning (optional) ─────────────────────────────

# Where OpenClaw's bind-mounted workspace state lives. The workflows service
# re-renders the agent's SOUL.md / IDENTITY.md here when you approve a learning.
# Defaults to ./data/openclaw-state; override only if you relocate state.
# OPENCLAW_STATE_DIR=./data/openclaw-state

# Enable the flagged outcome-signal proposal source (repeated-correction
# analyzer that emits low-confidence persona proposals). Off by default to
# avoid false signals; all proposals still require explicit approval.
# PERSONA_SIGNAL_LEARNING=1

# ─── Lead-CRM Profile (only used when CLAWRANGE_PROFILE=lead-crm) ──

# Portal lead export. The scrape source reads CSV from this URL. Provide
# whichever auth your portal uses; the profile's source.auth.kind selects it.
PORTAL_EXPORT_URL=
# api_key auth: sent as a custom header (header name set in the profile)
PORTAL_API_KEY=
# bearer auth: sent as Authorization: Bearer <token>
PORTAL_TOKEN=
# basic / login_form auth: portal account credentials
PORTAL_USERNAME=
PORTAL_PASSWORD=
# login_form auth: the URL that accepts the login POST
PORTAL_LOGIN_URL=

# CRM backend. Default adapter is the bundled SQLite CRM. CRM_DB_PATH sets
# where that database lives; leave unset to use the in-container /data/crm.db.
# For an offline local demo (make seed-demo), point it at a host path.
CRM_DB_PATH=
# Set these only when the profile's crm.adapter is "rest".
CRM_BASE_URL=
CRM_TOKEN=
